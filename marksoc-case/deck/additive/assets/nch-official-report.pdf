<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Page Not Found</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f9;
            color: #333;
        }

        .error-wrapper {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
        }

        .error-card {
            max-width: 620px;
            width: 100%;
            background: #ffffff;
            border-radius: 14px;
            padding: 40px 35px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        }

        .error-code {
            font-size: 72px;
            font-weight: 700;
            color: #d9534f;
            margin-bottom: 10px;
        }

        .error-title {
            font-size: 26px;
            margin-bottom: 12px;
            color: #222;
        }

        .error-message {
            font-size: 16px;
            line-height: 1.6;
            color: #666;
            margin-bottom: 28px;
        }

        .error-actions a {
            display: inline-block;
            text-decoration: none;
            background: #0d6efd;
            color: #fff;
            padding: 12px 22px;
            border-radius: 6px;
            font-size: 15px;
        }

        .error-actions a:hover {
            background: #084298;
        }

        .support-text {
            margin-top: 22px;
            font-size: 13px;
            color: #888;
        }

        @media (max-width: 576px) {
            .error-card {
                padding: 30px 20px;
            }

            .error-code {
                font-size: 54px;
            }

            .error-title {
                font-size: 22px;
            }
        }
    </style>
</head>
<body>
    <div class="error-wrapper">
        <div class="error-card">
            <div class="error-code">404</div>
            <h1 class="error-title">Page Not Found</h1>
            <p class="error-message">The page you are looking for does not exist or may have been moved.</p>

            <div class="error-actions">
                <a href="https://consumerhelpline.gov.in/public">Back to Home</a>
            </div>

            <div class="support-text">
                If the issue continues, please contact support.
            </div>
        </div>
    </div>
</body>
</html>